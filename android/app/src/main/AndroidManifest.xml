<?xml version="1.0" encoding="utf-8"?>
<!--
  App manifest / composition root. Declares the IME service (the only component
  the system binds as an input method) and the settings/onboarding launcher
  activity. Authored, not verified on device.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice typing (mic key) via the system SpeechRecognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".FeatherKeyApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FeatherKey">

        <!-- The keyboard. Protected by BIND_INPUT_METHOD so only the system may
             bind it; exported because the system is an external caller. -->
        <service
            android:name="com.featherkey.ime.FeatherKeyImeService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Settings + first-run consent (BR-22, BR-48). -->
        <activity
            android:name="com.featherkey.settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
